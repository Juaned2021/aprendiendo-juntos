# ============================================
# PLATAFORMA ESCOLAR - Environment Variables
# ============================================
# Este archivo contiene las variables de entorno para la aplicación
# NO commitar valores sensibles bajo control de versión
# Crear copias específicas para cada ambiente:
#   .env.development - Desarrollo local
#   .env.production  - Producción AWS
#   .env.staging     - Staging/QA

# ============================================
# CONFIGURACIÓN API
# ============================================

# Development: API local (C# backend en localhost:7028)
VITE_API_URL=https://apiaprendiendojuntos.onrender.com

# Production: API en AWS EC2
# VITE_API_URL=https://api.tudominio.com/api

# Staging: API en staging
# VITE_API_URL=https://staging-api.tudominio.com/api

# ============================================
# AWS S3 / CLOUDFRONT (para recursos)
# ============================================

# S3 Bucket para almacenamiento de archivos (PDFs, Word, etc)
# VITE_S3_BUCKET=plataforma-escolar-recursos

# CloudFront CDN URL (para descargas rápidas)
# VITE_CDN_URL=https://d123456789.cloudfront.net

# AWS Region
# VITE_AWS_REGION=us-east-1

# ============================================
# SEGURIDAD & MONITOREO
# ============================================

# Timeout para peticiones API (en ms)
VITE_API_TIMEOUT=10000

# Habilitar/deshabilitar logging en console
VITE_DEBUG_MODE=false

# Sentry DSN para error tracking (opcional)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Google Analytics (opcional)
# VITE_GA_ID=G-XXXXXXXXXX
